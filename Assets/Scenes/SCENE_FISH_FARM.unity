  m_Script: {fileID: 11500000, guid: 26ed2dbed0800b5438385e6262be3585, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::SceneIntroDirector
  blackOverlay: {fileID: 501284817}
  fadeInDuration: 1.2
  titleText: {fileID: 171234015}
  titleString: "\uC591\uC2DD\uC7A5\uC758 \uC778\uBA74\uC5B4"
  titleFadeDuration: 0.8
  titleHoldDuration: 1.8
  titleAfterMonologue: 1
  introLines:
  - "... \uBC29\uAE08\uC758 \uD30C\uB3C4\uB294 \uBB50\uC600\uC9C0..?"
  - "\uC2DC\uCCB4\uB4E4\uC774 \uC11E\uC778.. \uADF8\uB0E5 \uD30C\uB3C4\uB294 \uC544\uB2C8\uC5C8\uC5B4."
  - "...\uC815\uC2E0\uC5C6\uC774 \uB2EC\uB9AC\uB2E4 \uBCF4\uB2C8 \uC5B4\uB290\uB367
    \uC591\uC2DD\uC7A5\uC774\uB124."
  - "\uC758\uC0AC\uB294 \uC5EC\uAE30\uB85C \uB04C\uB824\uC654\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uC544\uBB34\uB3C4, \uADF8\uAC00 \uB098\uAC14\uB2E4\uB294
    \uC598\uAE30\uB294 \uD558\uC9C0 \uC54A\uC558\uB2E4."
  - "\u300E\uC791\uC5C5 \uC218\uCE59 \u2014 \uC218\uC870\uC5D0 \uC5BC\uAD74\uC744
    \uBE44\uCD94\uC9C0 \uB9D0 \uAC83.\u300F"
  - "\u300E\uBB3C\uC5D0\uC11C \uC0AC\uB78C \uC5BC\uAD74\uC744 \uBCF4\uC544\uB3C4,
    \uC808\uB300 \uB208\uC744 \uB9C8\uC8FC\uCE58\uC9C0 \uB9D0 \uAC83.\u300F"
  - "\u300E\uB9CC\uC57D \uC18C\uB9AC\uB97C \uC9C0\uB974\uBA70 \uC628\uB2E4\uBA74,
    \uBC18\uB4DC\uC2DC <color=red>\uC0C1\uC790</color>\uAC19\uC740 \uACF3\uC5D0 \uC228\uC744
    \uAC83.\u300F"
  - "... \uC5EC\uAE30\uB3C4 \uC774\uC0C1\uD55C \uD33B\uB9D0\uC774 \uC788\uB124."
  - "\uB300\uCCB4.. \uB204\uAC00 \uC801\uC740\uAC78\uAE4C."
  portrait: {fileID: 35585555}
  portraitCues:
  - lineIndex: 0
    emotion: 2
  - lineIndex: 2
    emotion: 0
  - lineIndex: 7
    emotion: 1
