  m_EditorClassIdentifier: Assembly-CSharp::SceneIntroDirector
  blackOverlay: {fileID: 2011818998}
  fadeInDuration: 1.2
  titleText: {fileID: 1727255623}
  titleString: "\uC591\uC2DD\uC7A5\uC758 \uC778\uBA74\uC5B4"
  titleFadeDuration: 0.8
  titleHoldDuration: 1.8
  titleAfterMonologue: 1
  introLines:
  - "...\uC591\uC2DD\uC7A5. \uBB3C\uBE44\uB9B0\uB0B4\uAC00 \uC5EC\uAE30\uAE4C\uC9C0."
  - "\uC758\uC0AC\uB294 \uC5EC\uAE30\uB85C \uB04C\uB824\uC654\uB2E4."
  - "\uADF8\uB9AC\uACE0 \uC544\uBB34\uB3C4, \uADF8\uAC00 \uB098\uAC14\uB2E4\uB294
    \uC598\uAE30\uB294 \uD558\uC9C0 \uC54A\uC558\uB2E4."
  - "\u300E\uC791\uC5C5 \uC218\uCE59 \u2014 \uC218\uC870\uC5D0 \uC5BC\uAD74\uC744
    \uBE44\uCD94\uC9C0 \uB9D0 \uAC83.\u300F"
  - "\u300E\uBB3C\uC5D0\uC11C \uC0AC\uB78C \uC5BC\uAD74\uC744 \uBCF4\uC544\uB3C4,
    \uC808\uB300 \uB208\uC744 \uB9C8\uC8FC\uCE58\uC9C0 \uB9D0 \uAC83.\u300F"
  - "\u300E\uB188\uC740 \uADC0\uAC00 \uBC1D\uB2E4. \uBC1C\uC18C\uB9AC\uB97C \uC8FD\uC774\uACE0,
    \uAE09\uD560 \uB550 \uAE30\uACC4\uB97C \uB3CC\uB824 \uADC0\uB97C \uC18D\uC77C
    \uAC83.\u300F"
